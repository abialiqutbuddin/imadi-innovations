# Copy this file to .env. Keep .env private.
# Generate your own secret with: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Dedicated local PostgreSQL database. These values match docker-compose.yml.
# Replace BOTH password occurrences with the same unique value.
POSTGRES_DB=imadi_website
POSTGRES_USER=imadi
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://imadi:replace-with-your-database-password@127.0.0.1:55432/imadi_website

# Local uploads live here. Docker overrides this with /app/media on a named volume.
MEDIA_UPLOAD_DIR=media

# Development automatically synchronizes schema. Keep false in production;
# production schema changes must use reviewed migrations.
PAYLOAD_DB_PUSH=false

# Optional local SQLite preview: leave DATABASE_URL empty and set this path.
# PostgreSQL is the intended production database.
# SQLITE_DATABASE_PATH=./imadi-local.db

# Optional Docker settings. Web is bound to localhost for a reverse proxy.
PORT=3100
HOST_BIND=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
